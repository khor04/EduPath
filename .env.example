# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore) -- every value below grants real access to a
# shared resource (database, email account, file storage, or a billed API),
# not just to one demo account, so treat all of them as secrets.

# Flask session-signing key. Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL connection string, e.g. from Supabase:
#   postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Gmail app password for the sender account configured in config.py
# (MAIL_USERNAME) -- used to send verification and password-reset emails.
# Generate one at https://myaccount.google.com/apppasswords
MAIL_PASSWORD=

# Cloudinary account (free tier is enough) -- used to store uploaded
# profile pictures. Find these on your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API key (free tier available) -- used to classify course
# content and power the AI academic planner.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
