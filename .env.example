# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore) -- every value below grants real access to a
# shared resource (database, email account, file storage, or a billed API),
# not just to one demo account, so treat all of them as secrets.

# Flask session-signing key. Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL connection string, e.g. from Supabase:
#   postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Brevo API key -- used to send verification and password-reset emails
# over Brevo's HTTPS transactional API (not SMTP: Render blocks outbound
# SMTP on free web services). Sign up free at https://www.brevo.com,
# verify the sender address configured in config.py (BREVO_SENDER_EMAIL)
# under Senders & IP, then create a key under SMTP & API > API Keys.
BREVO_API_KEY=

# Cloudinary account (free tier is enough) -- used to store uploaded
# profile pictures. Find these on your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API key (free tier available) -- used to classify course
# content and power the AI academic planner.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
